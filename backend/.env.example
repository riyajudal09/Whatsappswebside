PORT=5001
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/whatsapp_clone
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Real mobile OTP via Twilio Verify
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Phone OTP provider
# auto = use Twilio first; in local development fall back to a displayed OTP if Twilio Trial blocks the destination
# twilio = real SMS only; no fallback
# development = local testing only; OTP is shown in the app and backend console
PHONE_OTP_PROVIDER=auto
ALLOW_DEV_OTP_FALLBACK=true
DEV_OTP_TTL_MINUTES=5

# Optional email OTP
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_google_app_password

# Optional: if omitted, uploaded media is served locally from backend/uploads
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# MongoDB Atlas DNS fallback (helps Windows/networks that block SRV lookups)
MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1
MONGO_DOH_FALLBACK=true
MONGO_SERVER_SELECTION_TIMEOUT_MS=12000

# Email OTP provider for deployment
# Render Free blocks SMTP ports 25/465/587, so use Resend over HTTPS there.
EMAIL_PROVIDER=auto
RESEND_API_KEY=
# For Resend testing you can use: WhatsApp Clone <onboarding@resend.dev>
# For arbitrary recipients in production, use an address on your verified domain.
EMAIL_FROM=WhatsApp Clone <onboarding@resend.dev>
EMAIL_REQUEST_TIMEOUT_MS=12000
